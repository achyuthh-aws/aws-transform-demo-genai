@model AnyStateClaimsPortal.Web.Models.ClaimViewModel
@{ ViewBag.Title = "Submit New Claim"; }

<h2>Submit New Claim</h2>

@using (Html.BeginForm("Create", "Claims", FormMethod.Post, new { @class = "form-horizontal" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="panel panel-default">
        <div class="panel-heading"><h3 class="panel-title">Employee &amp; Injury Information</h3></div>
        <div class="panel-body">
            <div class="form-group">
                @Html.LabelFor(m => m.EmployeeId, new { @class = "col-md-3 control-label" })
                <div class="col-md-6">@Html.DropDownListFor(m => m.EmployeeId, Model.Employees, "Select Employee...", new { @class = "form-control" })</div>
            </div>
            <div class="form-group">
                @Html.LabelFor(m => m.InjuryDate, new { @class = "col-md-3 control-label" })
                <div class="col-md-6">@Html.TextBoxFor(m => m.InjuryDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })</div>
            </div>
            <div class="form-group">
                @Html.LabelFor(m => m.InjuryType, new { @class = "col-md-3 control-label" })
                <div class="col-md-6">@Html.DropDownListFor(m => m.InjuryType, Model.InjuryTypes, "Select Type...", new { @class = "form-control" })</div>
            </div>
            <div class="form-group">
                @Html.LabelFor(m => m.BodyPartAffected, new { @class = "col-md-3 control-label" })
                <div class="col-md-6">@Html.TextBoxFor(m => m.BodyPartAffected, new { @class = "form-control" })</div>
            </div>
            <div class="form-group">
                @Html.LabelFor(m => m.IncidentLocation, new { @class = "col-md-3 control-label" })
                <div class="col-md-6">@Html.TextBoxFor(m => m.IncidentLocation, new { @class = "form-control" })</div>
            </div>
            <div class="form-group">
                @Html.LabelFor(m => m.LocationType, new { @class = "col-md-3 control-label" })
                <div class="col-md-6">@Html.DropDownListFor(m => m.LocationType, Model.LocationTypes, "Select...", new { @class = "form-control" })</div>
            </div>
            <div class="form-group">
                @Html.LabelFor(m => m.InjuryDescription, new { @class = "col-md-3 control-label" })
                <div class="col-md-6">@Html.TextAreaFor(m => m.InjuryDescription, new { @class = "form-control", rows = 4 })</div>
            </div>
            <div class="form-group">
                @Html.LabelFor(m => m.WitnessName, new { @class = "col-md-3 control-label" })
                <div class="col-md-6">@Html.TextBoxFor(m => m.WitnessName, new { @class = "form-control" })</div>
            </div>
            <div class="form-group">
                @Html.LabelFor(m => m.WitnessPhone, new { @class = "col-md-3 control-label" })
                <div class="col-md-6">@Html.TextBoxFor(m => m.WitnessPhone, new { @class = "form-control" })</div>
            </div>
            <div class="form-group">
                @Html.LabelFor(m => m.WitnessStatement, new { @class = "col-md-3 control-label" })
                <div class="col-md-6">@Html.TextAreaFor(m => m.WitnessStatement, new { @class = "form-control", rows = 3 })</div>
            </div>
        </div>
    </div>

    <div class="form-group">
        <div class="col-md-offset-3 col-md-6">
            <button type="submit" class="btn btn-primary">Submit Claim</button>
            @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-default" })
        </div>
    </div>
}
