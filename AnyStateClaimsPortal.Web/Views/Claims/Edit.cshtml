@model AnyStateClaimsPortal.Web.Models.ClaimViewModel
@{ ViewBag.Title = "Edit Claim " + Model.ClaimNumber; }

<h2>Edit Claim @Model.ClaimNumber</h2>

@using (Html.BeginForm("Edit", "Claims", FormMethod.Post, new { @class = "form-horizontal" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.ClaimId)
    @Html.HiddenFor(m => m.ClaimNumber)
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="panel panel-default">
        <div class="panel-heading"><h3 class="panel-title">Update Claim</h3></div>
        <div class="panel-body">
            <div class="form-group">
                <label class="col-md-3 control-label">Current Status</label>
                <div class="col-md-6"><p class="form-control-static"><span class="label label-info">@Model.Status</span></p></div>
            </div>
            <div class="form-group">
                <label class="col-md-3 control-label">New Status</label>
                <div class="col-md-6">@Html.DropDownList("Status", ViewBag.AllowedStatuses as SelectList, "— No Change —", new { @class = "form-control" })</div>
            </div>
            <div class="form-group">
                @Html.LabelFor(m => m.AssignedAdjusterId, "Adjuster", new { @class = "col-md-3 control-label" })
                <div class="col-md-6">@Html.DropDownListFor(m => m.AssignedAdjusterId, Model.Adjusters, "Unassigned", new { @class = "form-control" })</div>
            </div>
            <div class="form-group">
                @Html.LabelFor(m => m.MedicalReviewerId, "Medical Reviewer", new { @class = "col-md-3 control-label" })
                <div class="col-md-6">@Html.DropDownListFor(m => m.MedicalReviewerId, Model.MedicalReviewers, "Unassigned", new { @class = "form-control" })</div>
            </div>
            <div class="form-group">
                @Html.LabelFor(m => m.DenialReason, new { @class = "col-md-3 control-label" })
                <div class="col-md-6">@Html.TextAreaFor(m => m.DenialReason, new { @class = "form-control", rows = 3 })</div>
            </div>
            <div class="form-group">
                <div class="col-md-offset-3 col-md-6">
                    <div class="checkbox">
                        <label>@Html.CheckBoxFor(m => m.IsLitigated) Litigated</label>
                    </div>
                </div>
            </div>
            <div class="form-group">
                @Html.LabelFor(m => m.ReturnToWorkDate, new { @class = "col-md-3 control-label" })
                <div class="col-md-6">@Html.TextBoxFor(m => m.ReturnToWorkDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })</div>
            </div>
        </div>
    </div>

    <div class="panel panel-default">
        <div class="panel-heading"><h3 class="panel-title">Add Note</h3></div>
        <div class="panel-body">
            <div class="form-group">
                @Html.LabelFor(m => m.NewNoteText, "Note", new { @class = "col-md-3 control-label" })
                <div class="col-md-6">@Html.TextAreaFor(m => m.NewNoteText, new { @class = "form-control", rows = 4 })</div>
            </div>
            <div class="form-group">
                @Html.Label("NewNoteType", "Type", new { @class = "col-md-3 control-label" })
                <div class="col-md-6">@Html.DropDownList("NewNoteType", new SelectList(new[] { "General", "Medical", "Legal", "Internal" }), new { @class = "form-control" })</div>
            </div>
        </div>
    </div>

    <div class="form-group">
        <div class="col-md-offset-3 col-md-6">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            @Html.ActionLink("Cancel", "Details", new { id = Model.ClaimId }, new { @class = "btn btn-default" })
        </div>
    </div>
}
