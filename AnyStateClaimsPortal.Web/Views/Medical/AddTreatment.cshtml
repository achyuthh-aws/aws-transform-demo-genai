@model AnyStateClaimsPortal.Web.Models.Entities.MedicalTreatment
@{ ViewBag.Title = "Add Treatment"; }

<h2>Add Treatment</h2>

@using (Html.BeginForm("AddTreatment", "Medical", FormMethod.Post, new { @class = "form-horizontal" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(m => m.ClaimId)

    <div class="form-group">
        @Html.LabelFor(m => m.TreatmentDate, new { @class = "col-md-3 control-label" })
        <div class="col-md-6">
            @Html.TextBoxFor(m => m.TreatmentDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.TreatmentType, new { @class = "col-md-3 control-label" })
        <div class="col-md-6">
            @Html.DropDownListFor(m => m.TreatmentType, new SelectList(new[] { "InitialVisit", "FollowUp", "Surgery", "PhysicalTherapy", "Diagnostic", "Prescription" }), "-- Select --", new { @class = "form-control" })
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.ProviderId, new { @class = "col-md-3 control-label" })
        <div class="col-md-6">
            @Html.DropDownList("ProviderId", ViewBag.Providers as SelectList, "-- Select Provider --", new { @class = "form-control" })
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.Description, new { @class = "col-md-3 control-label" })
        <div class="col-md-6">@Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = 3 })</div>
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.Diagnosis, new { @class = "col-md-3 control-label" })
        <div class="col-md-6">@Html.TextBoxFor(m => m.Diagnosis, new { @class = "form-control" })</div>
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.ICDCode, new { @class = "col-md-3 control-label" })
        <div class="col-md-6">@Html.TextBoxFor(m => m.ICDCode, new { @class = "form-control" })</div>
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.CPTCode, new { @class = "col-md-3 control-label" })
        <div class="col-md-6">@Html.TextBoxFor(m => m.CPTCode, new { @class = "form-control" })</div>
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.BilledAmount, new { @class = "col-md-3 control-label" })
        <div class="col-md-6">@Html.TextBoxFor(m => m.BilledAmount, new { @class = "form-control", type = "number", step = "0.01" })</div>
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.Notes, new { @class = "col-md-3 control-label" })
        <div class="col-md-6">@Html.TextAreaFor(m => m.Notes, new { @class = "form-control", rows = 2 })</div>
    </div>
    <div class="form-group">
        <div class="col-md-offset-3 col-md-6">
            <button type="submit" class="btn btn-primary"><span class="glyphicon glyphicon-floppy-disk"></span> Submit</button>
            <a href="@Url.Action("Index", new { claimId = Model.ClaimId })" class="btn btn-default">Cancel</a>
        </div>
    </div>
}
