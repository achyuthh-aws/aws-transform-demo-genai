@model AnyStateClaimsPortal.Web.Models.MedicalSummaryViewModel
@{ ViewBag.Title = "Medical Treatments"; }

<h2>Medical Treatments</h2>

<div class="well well-sm">
    <strong>Claim:</strong> @Model.ClaimNumber |
    <strong>Claim ID:</strong> @Model.ClaimId
</div>

<p>
    <a href="@Url.Action("AddTreatment", new { claimId = Model.ClaimId })" class="btn btn-success">
        <span class="glyphicon glyphicon-plus"></span> Add Treatment
    </a>
</p>

<div class="table-responsive">
    <table class="table table-striped table-bordered table-condensed">
        <thead>
            <tr>
                <th>Treatment Date</th><th>Type</th><th>Provider</th><th>Diagnosis</th>
                <th>ICD Code</th><th>Billed</th><th>Approved</th><th>Status</th><th>Next Appointment</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model.Treatments)
            {
                <tr>
                    <td>@t.TreatmentDate.ToString("MM/dd/yyyy")</td>
                    <td>@t.TreatmentType</td>
                    <td>@t.ProviderName</td>
                    <td>@t.Diagnosis</td>
                    <td>@t.ICDCode</td>
                    <td class="text-right">@t.BilledAmount.ToString("C")</td>
                    <td class="text-right">@t.ApprovedAmount.ToString("C")</td>
                    <td>
                        @{
                            var cls = t.Status == "Approved" ? "success" : t.Status == "Pending" ? "warning" : t.Status == "Denied" ? "danger" : "default";
                        }
                        <span class="label label-@cls">@t.Status</span>
                    </td>
                    <td>@(t.NextAppointment.HasValue ? t.NextAppointment.Value.ToString("MM/dd/yyyy") : "")</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="active">
                <td colspan="5"><strong>Totals</strong></td>
                <td class="text-right"><strong>@Model.TotalBilled.ToString("C")</strong></td>
                <td class="text-right"><strong>@Model.TotalApproved.ToString("C")</strong></td>
                <td colspan="2"></td>
            </tr>
        </tfoot>
    </table>
</div>
