@model System.Collections.Generic.List<AnyStateClaimsPortal.Web.Models.Entities.SystemConfiguration>
@{ ViewBag.Title = "System Configuration"; }

<h2>System Configuration</h2>

<table class="table table-striped table-bordered table-condensed">
    <thead>
        <tr><th>Config Key</th><th>Value</th><th>Description</th><th>Category</th><th>Data Type</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            using (Html.BeginForm("UpdateConfig", "Admin", FormMethod.Post, new { @class = "form-inline" }))
            {
                @Html.AntiForgeryToken()
                @Html.Hidden("ConfigId", c.ConfigId)
                <tr>
                    <td>@c.ConfigKey</td>
                    <td><input type="text" name="ConfigValue" value="@c.ConfigValue" class="form-control input-sm" style="width:100%;" /></td>
                    <td>@c.Description</td>
                    <td>@c.Category</td>
                    <td>@c.DataType</td>
                    <td><button type="submit" class="btn btn-primary btn-xs"><span class="glyphicon glyphicon-floppy-save"></span> Save</button></td>
                </tr>
            }
        }
    </tbody>
</table>
