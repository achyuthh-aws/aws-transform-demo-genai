@model System.Collections.Generic.List<AnyStateClaimsPortal.Web.Models.PaymentListItem>
@{ ViewBag.Title = "Payments"; }

<h2>Payments</h2>

<p>
    <a href="@Url.Action("Create")" class="btn btn-success"><span class="glyphicon glyphicon-plus"></span> Add Payment</a>
    <a href="@Url.Action("ProcessBatch")" class="btn btn-warning"><span class="glyphicon glyphicon-cog"></span> Process Batch</a>
</p>

<div class="table-responsive">
    <table class="table table-striped table-bordered table-condensed">
        <thead>
            <tr>
                <th>Payment Date</th><th>Type</th><th>Payee</th><th>Amount</th>
                <th>Check #</th><th>Status</th><th>Fiscal Year</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.PaymentDate.ToString("MM/dd/yyyy")</td>
                    <td>@p.PaymentType</td>
                    <td>@p.PayeeName</td>
                    <td class="text-right">@p.Amount.ToString("C")</td>
                    <td>@p.CheckNumber</td>
                    <td>
                        @{
                            var cls = p.PaymentStatus == "Approved" ? "success" : p.PaymentStatus == "Pending" ? "warning" : p.PaymentStatus == "Denied" ? "danger" : "default";
                        }
                        <span class="label label-@cls">@p.PaymentStatus</span>
                    </td>
                    <td>@p.FiscalYear</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="active">
                <td colspan="3"><strong>Total</strong></td>
                <td class="text-right"><strong>@Model.Sum(p => p.Amount).ToString("C")</strong></td>
                <td colspan="3"></td>
            </tr>
        </tfoot>
    </table>
</div>
