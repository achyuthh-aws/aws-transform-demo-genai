@model AnyStateClaimsPortal.Web.Models.PaymentViewModel
@{ ViewBag.Title = "New Payment"; }

<h2>New Payment</h2>

@using (Html.BeginForm("Create", "Payments", FormMethod.Post, new { @class = "form-horizontal" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(m => m.ClaimId)

    <div class="form-group">
        @Html.LabelFor(m => m.ClaimNumber, new { @class = "col-md-3 control-label" })
        <div class="col-md-6">
            @Html.TextBoxFor(m => m.ClaimNumber, new { @class = "form-control", @readonly = "readonly" })
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.PaymentDate, new { @class = "col-md-3 control-label" })
        <div class="col-md-6">
            @Html.TextBoxFor(m => m.PaymentDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
            @Html.ValidationMessageFor(m => m.PaymentDate, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.PaymentType, new { @class = "col-md-3 control-label" })
        <div class="col-md-6">
            @Html.DropDownListFor(m => m.PaymentType, Model.PaymentTypes, "-- Select --", new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.PaymentType, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.Amount, new { @class = "col-md-3 control-label" })
        <div class="col-md-6">
            @Html.TextBoxFor(m => m.Amount, new { @class = "form-control", type = "number", step = "0.01" })
            @Html.ValidationMessageFor(m => m.Amount, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.PayeeName, new { @class = "col-md-3 control-label" })
        <div class="col-md-6">
            @Html.TextBoxFor(m => m.PayeeName, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.PayeeName, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.PayeeType, new { @class = "col-md-3 control-label" })
        <div class="col-md-6">
            @Html.DropDownListFor(m => m.PayeeType, Model.PayeeTypes, "-- Select --", new { @class = "form-control" })
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.CheckNumber, new { @class = "col-md-3 control-label" })
        <div class="col-md-6">@Html.TextBoxFor(m => m.CheckNumber, new { @class = "form-control" })</div>
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.Description, new { @class = "col-md-3 control-label" })
        <div class="col-md-6">@Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = 3 })</div>
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.FiscalYear, new { @class = "col-md-3 control-label" })
        <div class="col-md-6">@Html.TextBoxFor(m => m.FiscalYear, new { @class = "form-control" })</div>
    </div>
    <div class="form-group">
        <div class="col-md-offset-3 col-md-6">
            <button type="submit" class="btn btn-primary"><span class="glyphicon glyphicon-floppy-disk"></span> Submit</button>
            <a href="@Url.Action("Index")" class="btn btn-default">Cancel</a>
        </div>
    </div>
}
